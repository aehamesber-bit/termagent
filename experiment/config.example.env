# Configuration for Kilo Dialogue Experiment
# Copy this file to config.env and fill in your OpenRouter API key

# OpenRouter API Key (required)
# Get your key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: Override model selection
# MODEL_MARWAN=poolside/laguna-s-2.1:free
# MODEL_SALIM=nvidia/nemotron-3-ultra-550b-a55b:free

# Optional: Override dialogue parameters
# TARGET_ROUNDS=14
# MAX_TOKENS_PER_MESSAGE=2000
# TEMPERATURE=0.7